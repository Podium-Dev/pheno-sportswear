# Railway / Medusa runtime configuration. Store actual values in Railway only.
DATABASE_URL=
STORE_CORS=https://<pheno-storefront-domain>
ADMIN_CORS=https://<medusa-backend-domain>
AUTH_CORS=https://<pheno-storefront-domain>,https://<medusa-backend-domain>
JWT_SECRET=
COOKIE_SECRET=
DISABLE_MEDUSA_ADMIN=false
MEDUSA_WORKER_MODE=shared
PORT=9000

# Add these when Redis-backed production modules and a separate worker are enabled.
# REDIS_URL=
# CACHE_REDIS_URL=
# LOCKING_REDIS_URL=
