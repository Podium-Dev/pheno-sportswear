# Railway / Medusa runtime configuration. Store actual values in Railway only.
DATABASE_URL=
STORE_CORS=https://<pheno-storefront-domain>
ADMIN_CORS=https://<medusa-backend-domain>
AUTH_CORS=https://<pheno-storefront-domain>,https://<medusa-backend-domain>
JWT_SECRET=
COOKIE_SECRET=
DISABLE_MEDUSA_ADMIN=false
MEDUSA_WORKER_MODE=shared
PORT=9000

# Add these when Redis-backed production modules and a separate worker are enabled.
# REDIS_URL=
# CACHE_REDIS_URL=
# LOCKING_REDIS_URL=
# Isolated PHENO checkout preview. Leave unset until Stripe TEST credentials are supplied.
PHENO_CHECKOUT_PAYMENT_MODE=stripe
PHENO_STRIPE_SECRET_KEY=
PHENO_STRIPE_WEBHOOK_SECRET=

# The Next.js BFF uses this non-secret provider ID; it must match the module id above.
PHENO_STRIPE_PROVIDER_ID=pp_stripe_stripe

# Development-only fallback when Stripe is intentionally unavailable.
# PHENO_CHECKOUT_PAYMENT_MODE=manual
# PHENO_MANUAL_PAYMENT_PROVIDER_ID=pp_system_default
