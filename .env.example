# Keep the local catalogue for development and previews.
COMMERCE_PROVIDER=local
CART_PROVIDER=local

# Shopify Storefront API (set COMMERCE_PROVIDER=shopify)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_STOREFRONT_COUNTRY=GB

# Medusa Store API v2 (set COMMERCE_PROVIDER=medusa)
MEDUSA_BACKEND_URL=https://your-medusa-backend.example.com

# Isolated checkout preview only. Keep false until checkout infrastructure is validated.
CHECKOUT_ENABLED=false
PHENO_CHECKOUT_PAYMENT_MODE=stripe
PHENO_STRIPE_PROVIDER_ID=pp_stripe_stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Medusa backend only; never expose these to Next.js/browser code.
PHENO_STRIPE_SECRET_KEY=
PHENO_STRIPE_WEBHOOK_SECRET=
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
